# ==========================================
# SENSITIVE DATA - DO NOT COMMIT
# ==========================================

# Personal Information & Job Applications
# All personal resumes, cover letters, applications
job_search/

# Personal profile files (screening, writing, legacy)
job-scanner/config/profile*.txt
job-scanner/config/profile.txt

# LinkedIn search URLs (reveals job search)
job-scanner/config/searches.json
job-scanner/config/searches_*.json

# Generated Application Materials (all generated outputs)
job-scanner/output/
!job-scanner/output/.gitkeep

# Browser Session (LinkedIn credentials)
job-scanner/browser_profile/

# Prompt/Calibration files that may contain personal context
job-scanner/config/calibration_prompt*.md

